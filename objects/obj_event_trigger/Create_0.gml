// Área invisível: quando a protagonista entra, roda um evento.
// Creation Code da instância: event = "nome"; once = true/false;
// once = true: só roda uma vez no jogo inteiro (salva em flag "trig_<evento>").
// Se o evento devolver nada (condição não bate), ele tenta de novo na próxima vez que ela entrar.
event = "";
once = true;
inside = false;
